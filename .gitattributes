# 统一换行：仓库内一律 LF，Windows 检出时按需转换
* text=auto
*.sh        text eol=lf
*.conf      text eol=lf
*.md        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp3   binary
*.ogg   binary
*.opus  binary
*.glb   binary
*.gltf  binary
*.svg   text

# Keep audited upstream license prose byte-exact instead of rewriting its whitespace.
site/assets/fonts/OFL-*.txt -whitespace
apps/genshin-start/public/campus/fonts/OFL-*.txt -whitespace
apps/genshin-start/scripts/licenses/Apache-2.0.txt -whitespace
# Asset manifests hash license bytes too; make Windows/Linux checkouts identical.
apps/liyun-explorer/public/assets/fonts/*-OFL.txt text eol=lf -whitespace

# Preserve the audited campus calibration bytes and SHA-256 on all platforms.
apps/liyun-explorer/src/location/data/*.json -text whitespace=cr-at-eol
apps/liyun-explorer/src/location/vendor/*.mjs -text
