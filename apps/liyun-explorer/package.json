{
  "name": "liyun-campus-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "calibrate": "node scripts/start-studio.mjs",
    "studio": "node scripts/start-studio.mjs",
    "build:studio": "vite build --config vite.studio.config.ts && node scripts/finalize-studio.mjs",
    "test:studio": "node --test server/authoring.test.mjs server/author-http.test.mjs",
    "build": "tsc -b && vite build && node scripts/trim-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vitest run",
    "verify:map": "node scripts/verify-calibrated-map.mjs",
    "server": "node server/server.mjs",
    "test:server": "node server/store.test.mjs && node server/server.test.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "framer-motion": "^14.9.0",
    "gsap": "^3.15.0",
    "p5": "^1.11.11",
    "polygon-clipping": "0.15.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/p5": "^1.7.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.5"
  }
}
