{
  "name": "zhuiguangzhe-stage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b",
    "start": "node server/index.mjs",
    "test:backend": "node server/protocol-check.mjs && node server/raffle-check.mjs && node server/preload-check.mjs",
    "check:backend": "node --check server/index.mjs && node --check server/show-runtime.mjs && node --check public/sw.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^4.21.2",
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.170.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}