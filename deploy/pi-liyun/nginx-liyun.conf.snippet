# Local template only: owner reviews/installs it; this task does not deploy or reload nginx.
root /opt/projects/liyun/current;
index index.html;

# Match the security headers used by the Liyun vhost. If adding more server headers,
# repeat/include them inside the immutable location too (nginx add_header inheritance).
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Never let hidden files win an earlier asset-extension regex.
    location ~ /\.(?!well-known/) { deny all; }
    location ~* \.html$ { try_files $uri =404; expires -1; etag off; if_modified_since off; }
    location = /version.json { try_files $uri =404; expires -1; etag off; if_modified_since off; }

    # Vite-generated root JS/CSS chunks have an 8-character content hash.
    # Public images/fonts/maps/audio are NOT hashed merely because they live under /assets/.
    location ~ "^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:js|mjs|css)$" {
        try_files $uri =404;
        expires off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
    }
    location ~* \.opus$ {
        default_type audio/ogg;
        try_files $uri =404;
        expires -1;
        access_log off;
    }
    location ~* \.(?:glb|gltf|bin|ani|js|css|mjs|json|webp|avif|png|jpe?g|gif|svg|ico|woff2?|ttf|otf|mp3|m4a|ogg|wav|mp4|webm|wasm)$ {
        try_files $uri =404;
        expires -1;
        access_log off;
    }

location / { try_files $uri $uri/ =404; }

gzip on;
gzip_types text/css application/javascript application/json image/svg+xml;
