# Linux Docker Engine + Compose v2. Never put an admin token in this file.
# Required for Caddy mode. Leave empty only for --quick mode.
FROST_DOMAIN=
FROST_OFFICE_PORT=4196
FROST_IMAGE_TAG=4.0.7
# Review and optionally pin these official images by digest before production use.
NODE_IMAGE=node:24-alpine
CADDY_IMAGE=caddy:2-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
FROST_PRIVATE_SUBNET=172.30.79.0/24
FROST_CADDY_IP=172.30.79.2
FROST_ATLAS_IP=172.30.79.3
FROST_MIN_FREE_BYTES=268435456
FROST_MAX_DB_BYTES=8589934592
FROST_BODY_IDLE_MS=20000
FROST_MAX_UPLOADS=4
FROST_MAX_BODY_BYTES=25165824
FROST_MAX_MEDIA_BYTES=67108864
FROST_SCRYPT_CONCURRENCY=4
FROST_LIMIT_BUCKETS=20000
FROST_API_IP_LIMIT=24000
FROST_AUTH_IP_LIMIT=1200
FROST_STATIC_IP_LIMIT=60000
# New production databases are sealed. Existing databases are never auto-sealed.
