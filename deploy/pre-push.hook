#!/usr/bin/env bash
# Local pre-push validation only. Publishing is a separate explicit owner action.
# This template is not installed by editing it; never invokes SSH/scp or deployment.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
echo "[pre-push] Build and verify versioned public assets locally…"
node tools/build-site.mjs
node tools/build-site.mjs --check dist-site
echo "[pre-push] Local release validated. No server was contacted or deployed."
