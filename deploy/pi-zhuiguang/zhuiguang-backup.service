[Unit]
Description=Verify and back up the Zhuiguangzhe audience database

[Service]
Type=oneshot
User=zhuiguang
Group=zhuiguang
WorkingDirectory=/opt/projects/zhuiguang/current
Environment=PRESENTATION_DATA_DIR=/var/lib/zhuiguang/data
Environment=PRESENTATION_BACKUP_DIR=/var/lib/zhuiguang/backups
ExecStart=/opt/node24/bin/node server/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zhuiguang
