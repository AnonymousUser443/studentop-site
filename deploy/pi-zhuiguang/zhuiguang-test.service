[Unit]
Description=Zhuiguangzhe isolated in-memory test room
After=network.target

[Service]
User=zhuiguang
Group=zhuiguang
WorkingDirectory=/opt/projects/zhuiguang/current
Environment=NODE_ENV=production
Environment=PRESENTATION_HOST=127.0.0.1
Environment=PORT=4189
Environment=PRESENTATION_BASE=/zhuiguang/test/
Environment=PRESENTATION_PUBLIC_ORIGIN=https://studentop.cn:14355
Environment=PRESENTATION_EPHEMERAL=1
EnvironmentFile=/etc/zhuiguang/test.env
ExecStart=/opt/node24/bin/node server/index.mjs
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=/var/lib/zhuiguang
SyslogIdentifier=zhuiguang-test

[Install]
WantedBy=multi-user.target
