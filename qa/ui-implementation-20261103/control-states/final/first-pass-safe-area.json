    "fifthStatePolicy": "No fabricated busy state for synchronous navigation, tabs, sliders or switches. Real menu upcoming, calibration Undo, activity transition, and pending-location states are measured separately.",
    "semanticEquivalence": [
      {
        "control": "settings-select",
        "reason": "Pointerdown immediately opens the real listbox; its caret/expanded feedback is accepted without adding a second button animation."
      },
      {
        "control": "activity-selected-tab disabled during navigation",
        "reason": "The selected tab keeps its selection color/opacity while disabled. The owning dialog exposes aria-busy and the primary action shows a spinner and pending label, so the brief whole-page transition supplies busy feedback."
      },
      {
        "controls": "Synchronous menu navigation, category tabs, sliders and switches",
        "reason": "No asynchronous busy phase is supported; pending/disabled states are not fabricated to fill a universal five-state matrix."
      }
